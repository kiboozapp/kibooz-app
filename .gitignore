# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
*/build/

# Gradle files
.gradle/
.kotlin/

# Local configuration file (contains personal machine paths like SDK dir)
local.properties

# Proguard / R8 folder generated by Eclipse / Android Studio
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA / Android Studio project files
*.iml
.idea/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/caches/
.idea/shelf/
.idea/assetWizardSettings.xml

# Keystore files (Security: never commit private signing keys)
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Screencaps and temporary debug captures in root directory
# (keeps app/src/main/res images intact)
/*.png
/*.jpg
/*.jpeg
/*.mp4
