<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Camera, Internet, and Location -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pengingat sisa scan sampah, wajib diminta saat runtime sejak Android 13 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".KiboozApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiboozApp">

        <!-- 1. Splash Screen (Launcher Entry Point) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.KiboozApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Onboarding Screen -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- 3. Role Selection Screen (Orang Tua vs Guru) -->
        <activity
            android:name=".ui.auth.RoleSelectionActivity"
            android:exported="false" />

        <!-- 4. Login Screen -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4b. Register Screen -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4c. Kode verifikasi email untuk akun baru -->
        <activity
            android:name=".ui.auth.VerifikasiEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Guru Flow: Dashboard Guru -->
        <activity
            android:name=".ui.guru.DashboardGuruActivity"
            android:exported="false" />

        <!-- 6. Guru Flow: Multi-Chart Statistik Mood -->
        <activity
            android:name=".ui.guru.StatistikMoodActivity"
            android:exported="false" />

        <!-- 7. Guru Flow: Ruang Kelas (6 Mapel 3D) -->
        <activity
            android:name=".ui.guru.RuangKelasGuruActivity"
            android:exported="false" />

        <!-- 8. Guru Flow: Detail Kelas & Modul -->
        <activity
            android:name=".ui.guru.DetailKelasActivity"
            android:exported="false" />

        <!-- 8b. Guru Flow: Video Pembelajaran Kelas -->
        <activity
            android:name=".ui.guru.VideoPembelajaranActivity"
            android:exported="false" />
        <activity
            android:name=".ui.guru.GuruHistoryActivity"
            android:exported="false" />

        <!-- 8a. Guru Flow: Daftar 6 Tema Pembelajaran dalam Kelas -->
        <activity
            android:name=".ui.guru.TemaKelasGuruActivity"
            android:exported="false" />

        <!-- 8c. Guru Flow: Peserta Kelas (Guru & Siswa) -->
        <activity
            android:name=".ui.guru.PesertaKelasActivity"
            android:exported="false" />

        <!-- 8d. Guru Flow: Persetujuan Permintaan Pindah Kelas -->
        <activity
            android:name=".ui.guru.PermintaanPindahKelasActivity"
            android:exported="false" />

        <!-- 9. Guru Flow: Forum Diskusi Kelas -->
        <activity
            android:name=".ui.guru.ForumDiskusiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 10. Guru Flow: Profil & Kinerja Guru -->
        <activity
            android:name=".ui.profile.ProfilGuruActivity"
            android:exported="false" />

        <!-- 10b. Guru Flow: Detail Profil Guru -->
        <activity
            android:name=".ui.profile.DetailProfilGuruActivity"
            android:exported="false" />

        <!-- 11. Guru Flow: Edit Profil Guru -->
        <activity
            android:name=".ui.profile.EditProfilGuruActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11b. Akun (Guru dan Wali): Ubah Kata Sandi -->
        <activity
            android:name=".ui.account.UbahKataSandiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11c. Akun (Guru dan Wali): Pangkas Foto Profil -->
        <activity
            android:name=".ui.account.CropAvatarActivity"
            android:exported="false" />

        <!-- 11d. Lokasi (Guru dan Wali): Pemilih Lokasi lewat Peta -->
        <activity
            android:name=".ui.location.PickLocationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <!-- 12. Wali Flow: Dashboard Wali & Siswa -->
        <activity
            android:name=".ui.wali.DashboardWaliActivity"
            android:exported="false" />

        <!-- 13. Wali Flow: Ruang Kelas Si Kecil (Screenshot 154028) -->
        <activity
            android:name=".ui.wali.RuangKelasWaliActivity"
            android:exported="false" />

        <!-- 13c. Wali Flow: Riwayat Aktivitas Si Kecil -->
        <activity
            android:name=".ui.wali.RiwayatAktivitasWaliActivity"
            android:exported="false" />

        <!-- 14. Wali Flow: Detail Panduan Penanganan Mood 4-Langkah -->
        <activity
            android:name=".ui.wali.DetailPenangananMoodActivity"
            android:exported="false" />

        <!-- 15. Wali Flow: Statistik Pilah Sampah Organik vs Anorganik -->
        <activity
            android:name=".ui.wali.StatistikSampahActivity"
            android:exported="false" />

        <!-- 16. Wali Flow: Leaderboard Podium Juara & Peringkat Poin -->
        <activity
            android:name=".ui.wali.LeaderboardActivity"
            android:exported="false" />

        <!-- 17. Wali Flow: Profil Wali (Settings-First) -->
        <activity
            android:name=".ui.profile.ProfilWaliActivity"
            android:exported="false" />

        <!-- 18. Wali Flow: Profil Siswa & NISN -->
        <activity
            android:name=".ui.profile.ProfilSiswaActivity"
            android:exported="false" />

        <!-- 19. Wali Flow: Edit Profil Siswa & Wali -->
        <activity
            android:name=".ui.profile.EditProfilSiswaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 19b. Hapus Akun (Guru dan Wali) -->
        <activity
            android:name=".ui.account.HapusAkunActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 19c. Wali Flow: Tambah Anak dengan kode kelas -->
        <activity
            android:name=".ui.wali.TambahAnakActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 19d. Chat guru dan wali: daftar pesan dan satu percakapan -->
        <activity
            android:name=".ui.chat.ChatListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.chat.ChatMediaActivity"
            android:exported="false" />

        <!-- 18. AI Camera Overlay: Scan Mood Kelas (Guru) -->
        <activity
            android:name=".ui.camera.CameraScanMoodActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 19. AI Camera Overlay: Scan Sampah & Klaim Poin (Wali/Siswa) -->
        <activity
            android:name=".ui.camera.CameraScanSampahActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 20. Guru Flow: Review Hasil Scan Mood Siswa -->
        <activity
            android:name=".ui.camera.ReviewScanMoodActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
