<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_topbar_purple_gradient"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Kembali"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitleBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/anak_edit_judul"
            android:textColor="@color/kibooz_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="24dp"
                android:indeterminateTint="@color/kibooz_primary_purple" />

            <com.nthb.kibooz.ui.common.ConnectionStatusView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_connection_status"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/baloo2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:text="@string/coba_lagi"
                    android:textAllCaps="false"
                    android:textColor="@color/kibooz_white"
                    app:backgroundTint="@color/kibooz_primary_purple"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Data anak -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/kibooz_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="@string/anak_edit_bagian_anak"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardAvatarAnak"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                app:cardCornerRadius="32dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/kibooz_border"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/ivAvatarAnak"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/anak_avatar_siswa"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_avatar_siswa" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUbahFotoAnak"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/baloo2"
                                android:text="@string/avatar_ubah_foto_anak"
                                android:textAllCaps="false"
                                android:textColor="@color/kibooz_primary_purple"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="22dp"
                                app:strokeColor="@color/kibooz_primary_purple" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNisnPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#FFF4E0"
                            android:fontFamily="@font/baloo2"
                            android:padding="12dp"
                            android:text="@string/anak_nisn_perlu_isi_pesan"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNamaAnak"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_nama_anak">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNamaSiswa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:inputType="textPersonName|textCapWords"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNisn"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_nisn">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNisn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:inputType="number"
                                android:maxLength="30"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimpanAnak"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/baloo2"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/anak_simpan_anak"
                            android:textAllCaps="false"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/kibooz_primary_purple"
                            app:cornerRadius="26dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Data wali -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/kibooz_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="@string/anak_edit_bagian_wali"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardAvatarWali"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                app:cardCornerRadius="32dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/kibooz_border"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/ivAvatarWali"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/anak_avatar_wali"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_avatar_guru" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUbahFotoWali"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/baloo2"
                                android:text="@string/avatar_ubah_foto_wali"
                                android:textAllCaps="false"
                                android:textColor="@color/kibooz_primary_purple"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="22dp"
                                app:strokeColor="@color/kibooz_primary_purple" />

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNamaWali"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_nama_wali">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNamaWali"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:inputType="textPersonName|textCapWords"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Email tidak bisa diubah, jadi hanya dibaca -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_email"
                            app:helperText="@string/anak_hint_email_bantuan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:fontFamily="@font/baloo2"
                                android:inputType="textEmailAddress"
                                android:longClickable="false"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPhone"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_telepon"
                            app:helperText="@string/anak_hint_kosongkan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:inputType="phone"
                                android:maxLength="30"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWhatsapp"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_whatsapp"
                            app:helperText="@string/anak_hint_kosongkan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWhatsapp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:inputType="phone"
                                android:maxLength="30"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAlamat"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/anak_hint_alamat"
                            app:helperText="@string/anak_hint_kosongkan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAlamat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo2"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPilihPeta"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/baloo2"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/lokasi_pilih_lewat_peta"
                            android:textAllCaps="false"
                            android:textColor="@color/kibooz_primary_purple"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/kibooz_lavender_light"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_location"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/kibooz_primary_purple"
                            app:strokeColor="@color/kibooz_primary_purple"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimpanWali"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/baloo2"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/anak_simpan_wali"
                            android:textAllCaps="false"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/kibooz_primary_purple"
                            app:cornerRadius="26dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
