<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Overlay Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#80000000"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/baloo2"
            android:text="AI Pemindai Sampah"
            android:textColor="@color/kibooz_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivFlash"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Flashlight"
            android:src="@drawable/ic_refresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Viewport / Object Viewfinder -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomControls"
        app:layout_constraintTop_toBottomOf="@+id/clTopOverlay">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- Low Light Warning -->
        <TextView
            android:id="@+id/tvLowLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#CCE53935"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mood_cahaya_rendah"
            android:textColor="@color/kibooz_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Penanda model pengganti, tampil selama modelnya masih contoh -->
        <TextView
            android:id="@+id/tvModelContoh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:background="#CCF57C00"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/model_contoh_banner"
            android:textColor="@color/kibooz_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center Scanning Viewfinder Frame -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTargetFrame"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Detection Result Badge Inside Reticle -->
            <LinearLayout
                android:id="@+id/llDeteksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D9C62828"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="Sampah Anorganik"
                    android:textColor="@color/kibooz_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="Akurasi"
                    android:textColor="#FFEBEE"
                    android:textSize="12sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Instructions under viewfinder -->
        <TextView
            android:id="@+id/tvPetunjuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#99000000"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/sampah_mencari"
            android:textColor="@color/kibooz_white"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clTargetFrame" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Permission Denied Panel -->
    <include
        android:id="@+id/layoutIzinKamera"
        layout="@layout/view_camera_permission_denied"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTopOverlay" />

    <!-- Bottom Action Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llPoinHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_flame" />

            <TextView
                android:id="@+id/tvPoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/baloo2"
                android:text="@string/sampah_poin_siap"
                android:textColor="#F67E02"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Claim Points Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaimPoin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/sampah_klaim_tombol"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kibooz_primary_purple"
            app:cornerRadius="25dp"
            app:layout_constraintTop_toBottomOf="@+id/llPoinHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
