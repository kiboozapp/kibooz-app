<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootProfilGuru"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FD">

    <ScrollView
        android:id="@+id/svProfilContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header & Avatar Overlap Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeaderArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Curved Purple Header Background -->
                <View
                    android:id="@+id/viewHeaderBg"
                    android:layout_width="match_parent"
                    android:layout_height="156dp"
                    android:background="@drawable/bg_header_curved_purple"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title Header: Profil Guru -->
                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="Profil Guru"
                    android:textColor="@color/kibooz_white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/cardAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <!-- Circular Avatar Frame with White Border -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="96dp"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/kibooz_white"
                    app:strokeWidth="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivAvatarGuru"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar_guru"
                        android:contentDescription="Avatar Profil Guru" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Nama Guru -->
                <TextView
                    android:id="@+id/tvNamaGuru"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/baloo2"
                    android:text="Profil Guru"
                    android:textColor="#221C38"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardAvatar" />

                <!-- Tanggal Bergabung -->
                <TextView
                    android:id="@+id/tvJoinDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/baloo2"
                    android:text="Bergabung di Kibooz"
                    android:textColor="#7A7593"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvNamaGuru" />

                <!-- Button Lihat Detail -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLihatDetail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/kibooz_primary_purple"
                    android:fontFamily="@font/baloo2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Lihat Detail"
                    android:textAllCaps="false"
                    android:textColor="@color/kibooz_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:elevation="4dp"
                    app:icon="@drawable/ic_badge_id"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/kibooz_white"
                    app:layout_constraintTop_toBottomOf="@+id/tvJoinDate" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Settings Menu List Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#EAE7F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <!-- Menu 1: Ubah Kata Sandi -->
                    <LinearLayout
                        android:id="@+id/menuUbahSandi"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_key"
                            app:tint="@color/kibooz_primary_purple" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/baloo2"
                            android:text="Ubah Kata sandi"
                            android:textColor="#2A2740"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9E9E9E" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="#F0EEF7" />

                    <!-- Menu 2: Syarat dan Ketentuan -->
                    <LinearLayout
                        android:id="@+id/menuSyaratKetentuan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/kibooz_primary_purple" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/baloo2"
                            android:text="Syarat dan ketentuan"
                            android:textColor="#2A2740"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9E9E9E" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="#F0EEF7" />

                    <!-- Menu 3: Kebijakan Privasi -->
                    <LinearLayout
                        android:id="@+id/menuKebijakanPrivasi"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/kibooz_primary_purple" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/baloo2"
                            android:text="Kebijakan Privasi"
                            android:textColor="#2A2740"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9E9E9E" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="#F0EEF7" />

                    <!-- Menu 4: Panduan -->
                    <LinearLayout
                        android:id="@+id/menuPanduan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_book"
                            app:tint="@color/kibooz_primary_purple" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/baloo2"
                            android:text="Panduan"
                            android:textColor="#2A2740"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9E9E9E" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="#F0EEF7" />

                    <!-- Menu 5: Keluar Akun (Merah) -->
                    <LinearLayout
                        android:id="@+id/menuKeluar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_logout"
                            app:tint="#E53935" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/baloo2"
                            android:text="Keluar"
                            android:textColor="#E53935"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="#F0EEF7" />

                    <!-- Menu 6: Hapus Akun -->
                    <LinearLayout
                        android:id="@+id/menuHapusAkun"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trash_delete"
                            app:tint="#E53935" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/baloo2"
                            android:text="@string/hapus_akun_menu"
                            android:textColor="#E53935"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar with Center Floating Scanner FAB -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/kibooz_white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Tab 1: Home (Dashboard Guru) -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 2: Statistik Mood -->
            <LinearLayout
                android:id="@+id/tabStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Center Placeholder for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Tab 4: Kelas (Ruang Kelas) -->
            <LinearLayout
                android:id="@+id/tabKelas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_class"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 5: Profil Guru (ACTIVE) -->
            <LinearLayout
                android:id="@+id/tabProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/kibooz_primary_purple" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dot_active" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Floating Action Button (Scan Face / Mood) -->
    <ImageButton
        android:id="@+id/fabScannerFace"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab_scanner"
        android:contentDescription="Scan Face Mood AI"
        android:elevation="16dp"
        android:src="@drawable/ic_scan_face"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
