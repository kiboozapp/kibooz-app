<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootPickLocation"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_topbar_purple_gradient"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kembali"
            android:padding="2dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/lokasi_peta_judul"
            android:textColor="@color/kibooz_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Map Viewport Area -->
    <FrameLayout
        android:id="@+id/flMapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cardAddressPreview"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Dot Bayangan Pin di Titik Tengah Tepat -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot_active"
            android:alpha="0.4" />

        <!-- Pin Lokasi Pusat Peta (ujung bawah pin sejajar titik tengah) -->
        <ImageView
            android:id="@+id/ivCenterPin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="@string/lokasi_peta_judul"
            android:src="@drawable/ic_map_pin_marker"
            android:translationY="-20dp" />

        <!-- Kolom Pencarian + Saran Lokasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/kibooz_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/lokasi_cari_tombol"
                        android:src="@drawable/ic_search"
                        app:tint="@color/kibooz_text_secondary" />

                    <EditText
                        android:id="@+id/etSearchLocation"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/baloo2"
                        android:hint="@string/lokasi_cari_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/kibooz_text_dark"
                        android:textColorHint="@color/kibooz_text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/kibooz_text_muted"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/pbSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:indeterminateTint="@color/kibooz_primary_purple"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchLocation"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:fontFamily="@font/baloo2"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="56dp"
                        android:text="@string/lokasi_cari_tombol"
                        android:textAllCaps="false"
                        android:textColor="@color/kibooz_primary_purple"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/kibooz_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/llSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Tombol Lokasi Saat Ini (GPS) -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/lokasi_gps_tombol"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_primary_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kibooz_white"
            app:icon="@drawable/ic_my_location"
            app:iconTint="@color/kibooz_primary_purple" />

    </FrameLayout>

    <!-- Bottom Card Konfirmasi Lokasi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAddressPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/kibooz_white"
        app:cardElevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TopRounded36"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/llAddressPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="@string/lokasi_petunjuk_geser"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/lokasi_peta_judul"
                    android:src="@drawable/ic_location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo2"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:text="@string/lokasi_memuat_alamat"
                        android:textColor="@color/kibooz_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/baloo2"
                        android:textColor="@color/kibooz_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbReverse"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:indeterminateTint="@color/kibooz_primary_purple"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGunakanLokasi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lokasi_gunakan"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/kibooz_primary_purple"
                app:cornerRadius="25dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
