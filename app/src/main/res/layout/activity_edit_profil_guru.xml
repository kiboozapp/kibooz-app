<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_topbar_purple_gradient"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitleBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/baloo2"
            android:text="Edit Profil Guru"
            android:textColor="@color/kibooz_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- Avatar Change Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/kibooz_white"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto Profil Guru"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar_guru" />

                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivChangePhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_purple"
                    android:contentDescription="Ganti Foto"
                    android:elevation="4dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_camera"
                    app:layout_constraintBottom_toBottomOf="@+id/cardAvatar"
                    app:layout_constraintEnd_toEndOf="@+id/cardAvatar"
                    app:tint="@color/kibooz_white" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvUbahFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/baloo2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Ketuk untuk ubah foto profil"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Nama Lengkap -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/baloo2"
                android:text="Nama Lengkap &amp; Gelar"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNamaGuru"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/baloo2"
                android:paddingHorizontal="16dp"
                android:text="Ibu Siti Rahayu, S.Pd."
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp" />

            <!-- NIP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/baloo2"
                android:text="NIP (Nomor Induk Pegawai)"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:cursorVisible="false"
                android:focusable="false"
                android:fontFamily="@font/baloo2"
                android:longClickable="false"
                android:paddingHorizontal="16dp"
                android:text="-"
                android:textColor="@color/kibooz_text_muted"
                android:textSize="14sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/baloo2"
                android:text="Email Dinas"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:cursorVisible="false"
                android:focusable="false"
                android:fontFamily="@font/baloo2"
                android:inputType="textEmailAddress"
                android:longClickable="false"
                android:paddingHorizontal="16dp"
                android:text="-"
                android:textColor="@color/kibooz_text_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:text="@string/guru_profil_nip_email_tetap"
                android:textColor="@color/kibooz_text_muted"
                android:textSize="12sp" />

            <!-- Nomor HP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/baloo2"
                android:text="Nomor WhatsApp"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/baloo2"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:text="+62 812-3456-7890"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp" />

            <!-- Alamat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/baloo2"
                android:text="Alamat Sekolah / Domisili"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAlamat"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/baloo2"
                android:gravity="top|start"
                android:hint="Ketik alamat manual atau pilih di peta"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="Jl. Melati No. 14, Lowokwaru, Kota Malang"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPilihPeta"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lokasi_pilih_lewat_peta"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/kibooz_lavender_light"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/kibooz_primary_purple"
                app:strokeColor="@color/kibooz_primary_purple"
                app:strokeWidth="1dp" />

            <!-- Button Simpan Perubahan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Simpan Perubahan"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/kibooz_primary_purple"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
