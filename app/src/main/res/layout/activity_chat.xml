<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_topbar_purple_gradient"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kembali"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/flHeaderAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chat_avatar"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="#472F91"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivRoomIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chat_avatar"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_class"
                    android:visibility="gone"
                    app:tint="#472F91" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/flHeaderAvatar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/baloo2"
                android:maxLines="1"
                android:textColor="@color/kibooz_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/baloo2"
                android:maxLines="1"
                android:textColor="@color/chat_own_meta_text"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Polling gagal karena tidak ada koneksi. Pesan lama tetap tampil -->
    <TextView
        android:id="@+id/tvOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_offline_background"
        android:fontFamily="@font/baloo2"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/chat_offline"
        android:textColor="@color/chat_offline_text"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar" />

    <!-- Gangguan server saat muat awal: offline atau layanan tidak tersedia (FE-12) -->
    <com.nthb.kibooz.ui.common.ConnectionStatusView
        android:id="@+id/connectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tvOffline" />

    <FrameLayout
        android:id="@+id/flBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clInputBar"
        app:layout_constraintTop_toBottomOf="@+id/connectionStatus">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />

        <!-- Memuat -->
        <LinearLayout
            android:id="@+id/llMemuat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/chat_memuat_pesan"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/baloo2"
                android:text="@string/chat_memuat_pesan"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Gagal dimuat -->
        <LinearLayout
            android:id="@+id/llGagal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="@string/chat_percakapan_gagal"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGagalPesan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCobaLagi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="24dp"
                android:text="@string/coba_lagi"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/kibooz_primary_purple"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <!-- Belum ada pesan -->
        <LinearLayout
            android:id="@+id/llKosong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="@string/chat_kosong_pesan_judul"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKosongIsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Kotak tulis, atau keterangan bahwa percakapan ditutup -->
    <FrameLayout
        android:id="@+id/clInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kibooz_white"
        android:elevation="10dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Lampiran yang dipilih dan belum dikirim -->
            <LinearLayout
                android:id="@+id/llAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/ivAttachment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_chat_media"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressAttachment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="28dp" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvAttachment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnRemoveAttachment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/chat_buang"
                    android:textColor="@color/kibooz_purple_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnAttach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chat_lampirkan_cd"
                    android:padding="12dp"
                    android:src="@drawable/ic_attach" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_input"
                    android:fontFamily="@font/baloo2"
                    android:hint="@string/chat_tulis_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:maxLines="5"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/kibooz_text_dark"
                    android:textColorHint="@color/kibooz_text_secondary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_purple"
                    android:contentDescription="@string/chat_kirim_cd"
                    android:padding="12dp"
                    android:src="@drawable/ic_send" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvClosed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_closed_note"
            android:fontFamily="@font/baloo2"
            android:padding="14dp"
            android:textColor="@color/kibooz_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
