<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootHapusAkun"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_topbar_purple_gradient"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hapus_akun_kembali"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitleBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/hapus_akun_judul"
            android:textColor="@color/kibooz_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- Peringatan: apa yang hilang dan bahwa ini tidak bisa dibatalkan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_warning"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/hapus_akun_peringatan_judul"
                    android:textColor="#7F1D1D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPeringatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Kata sandi saat ini -->
            <TextView
                android:id="@+id/tvLabelSandi"
                android:labelFor="@+id/etPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/baloo2"
                android:text="@string/hapus_akun_label_sandi"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/kibooz_primary_purple" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="@font/baloo2"
                    android:hint="@string/hapus_akun_hint_sandi"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLength="72"
                    android:textColor="@color/kibooz_text_primary"
                    android:textColorHint="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hapus_akun_toggle_sandi"
                    android:padding="13dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/kibooz_primary_purple" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/baloo2"
                android:textColor="@color/kibooz_red_danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Hanya untuk Guru -->
            <LinearLayout
                android:id="@+id/llSuccessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLabelSuccessor"
                    android:labelFor="@+id/etSuccessor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/hapus_akun_label_pengganti_opsional"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSuccessor"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="@font/baloo2"
                    android:hint="@string/hapus_akun_hint_pengganti"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLength="255"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/kibooz_text_primary"
                    android:textColorHint="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessorError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_red_danger"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/hapus_akun_penjelasan_pengganti"
                    android:textColor="@color/kibooz_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Kartu gangguan server dengan tombol coba lagi -->
            <com.nthb.kibooz.ui.common.ConnectionStatusView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHapus"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_danger"
                android:fontFamily="@font/baloo2"
                android:text="@string/hapus_akun_tombol"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
