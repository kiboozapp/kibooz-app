<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar / Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved_purple"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/baloo2"
            android:text="Ruang Kelas Guru"
            android:textColor="@color/kibooz_white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/ivBack"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="@+id/ivBack" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/baloo2"
            android:text="Pilih dan kelola kelas aktivitas emosi &amp; belajar anak"
            android:textColor="#E0DBF5"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/clBottomNavigation"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Judul daftar dan Tambah Kelas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDaftarJudul"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTambahKelas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/kelola_tambah"
                    android:textAllCaps="false"
                    android:textColor="@color/kibooz_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/kibooz_primary_purple"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <!-- Cari kelas -->
            <LinearLayout
                android:id="@+id/llCari"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/kibooz_text_secondary" />

                <EditText
                    android:id="@+id/etSearchKelas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:contentDescription="@string/kelola_cari_cd"
                    android:fontFamily="@font/baloo2"
                    android:hint="@string/kelola_cari_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/kibooz_text_dark"
                    android:textColorHint="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Gangguan server: offline atau layanan tidak tersedia (FE-12) -->
            <com.nthb.kibooz.ui.common.ConnectionStatusView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Memuat -->
            <LinearLayout
                android:id="@+id/llMemuat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:contentDescription="@string/kelola_memuat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/kelola_memuat"
                    android:textColor="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Belum ada kelas -->
            <LinearLayout
                android:id="@+id/llKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/kelola_kosong_judul"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:text="@string/kelola_kosong_isi"
                    android:textColor="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Daftar gagal dimuat -->
            <LinearLayout
                android:id="@+id/llGagal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/kelola_gagal_judul"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGagalPesan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:textColor="@color/kibooz_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCobaLagi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/baloo2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/coba_lagi"
                    android:textAllCaps="false"
                    android:textColor="@color/kibooz_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/kibooz_primary_purple"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTidakCocok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:text="@string/kelola_tidak_ada_hasil"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Kelas aktif, satu kartu untuk setiap kelas -->
            <LinearLayout
                android:id="@+id/llKelasAktif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- Kelas yang diarsipkan -->
            <LinearLayout
                android:id="@+id/llArsip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvArsipJudul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/kelola_arsip_info"
                    android:textColor="@color/kibooz_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llKelasArsip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_card_white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Beranda"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 2: Statistik -->
            <LinearLayout
                android:id="@+id/tabStatistik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Statistik"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Center Placeholder for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Tab 4: Kelas (ACTIVE) -->
            <LinearLayout
                android:id="@+id/tabKelas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Kelas"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_class"
                    app:tint="@color/kibooz_primary_purple" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dot_active" />

            </LinearLayout>

            <!-- Tab 5: Profil -->
            <LinearLayout
                android:id="@+id/tabProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Profil"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Floating Action Button (Scan Face / Mood) -->
    <ImageButton
        android:id="@+id/fabScanner"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab_scanner"
        android:contentDescription="Scan Mood Siswa"
        android:elevation="16dp"
        android:src="@drawable/ic_scan_face"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
