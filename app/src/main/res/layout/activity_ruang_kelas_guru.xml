<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar / Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved_purple"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali"
            app:tint="@color/kibooz_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/baloo2"
            android:text="Ruang Kelas Guru"
            android:textColor="@color/kibooz_white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/ivBack"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="@+id/ivBack" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/baloo2"
            android:text="Pilih dan kelola kelas aktivitas emosi &amp; belajar anak"
            android:textColor="#E0DBF5"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/clBottomNavigation"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Action Bar: Search & Tambah Kelas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/baloo2"
                    android:text="Daftar Kelas (6)"
                    android:textColor="@color/kibooz_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Tombol Tambah Kelas -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTambahKelas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:text="+ Tambah Kelas"
                    android:textAllCaps="false"
                    android:textColor="@color/kibooz_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/kibooz_primary_purple"
                    app:cornerRadius="20dp" />

            </LinearLayout>

            <!-- Search Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/kibooz_text_muted" />

                <EditText
                    android:id="@+id/etSearchKelas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:fontFamily="@font/baloo2"
                    android:hint="Cari nama mata pelajaran / kode..."
                    android:textColor="@color/kibooz_text_dark"
                    android:textColorHint="@color/kibooz_text_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 2-Column Grid of 6 Subject Cards -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- 1. Seni & Kreativitas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelSeni"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFF8E7"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#FFE0B2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_seni" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Seni &amp; Kreativitas"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Bahasa & Komunikasi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelBahasa"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#C8E6C9"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_bahasa" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Bahasa &amp; Komunikasi"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Berpikir & Logika -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelLogika"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#E3F2FD"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#BBDEFB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_logika" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Berpikir &amp; Logika"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Belajar Fisik Motorik -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelMotorik"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FCE4EC"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#F8BBD0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_motorik" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Fisik &amp; Motorik"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Nilai Agama & Moral -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelAgama"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#EDE7F6"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#D1C4E9"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_agama" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Agama &amp; Moral"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Sosial & Emosional -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelSosial"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#FFE0B2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_sosial" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Sosial &amp; Emosional"
                            android:textColor="@color/kibooz_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="6 Modul • Kelas A"
                            android:textColor="@color/kibooz_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_card_white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 2: Statistik -->
            <LinearLayout
                android:id="@+id/tabStatistik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Center Placeholder for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Tab 4: Kelas (ACTIVE) -->
            <LinearLayout
                android:id="@+id/tabKelas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_class"
                    app:tint="@color/kibooz_primary_purple" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dot_active" />

            </LinearLayout>

            <!-- Tab 5: Profil -->
            <LinearLayout
                android:id="@+id/tabProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Floating Action Button (Scan Face / Mood) -->
    <ImageButton
        android:id="@+id/fabScanner"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab_scanner"
        android:contentDescription="Scan Mood Siswa"
        android:elevation="16dp"
        android:src="@drawable/ic_scan_face"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
