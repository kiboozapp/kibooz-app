<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardKelas"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/kibooz_white"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/kibooz_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2"
                android:textColor="@color/kibooz_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/baloo2"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/baloo2"
            android:textColor="@color/kibooz_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAnak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2"
            android:textColor="@color/kibooz_text_secondary"
            android:textSize="13sp" />

        <!-- Kode kelas dan salin, hanya untuk kelas aktif -->
        <LinearLayout
            android:id="@+id/llKode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag_lavender"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2"
                android:text="@string/kelola_kode_label"
                android:textColor="@color/kibooz_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:letterSpacing="0.08"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalin"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:text="@string/kelola_salin"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermintaanPindah"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/guru_pindah_cek"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_primary_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="20dp"
            app:strokeColor="@color/kibooz_primary_purple" />

        <!-- Guru kelas, juga untuk kelas arsip karena daftarnya tetap bisa dibaca -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuru"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/pengajar_tombol_kartu"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_primary_purple"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Aksi kelas aktif -->
        <LinearLayout
            android:id="@+id/llAksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKodeBaru"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="2"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/kelola_aksi_kode_baru"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPendaftaran"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="2"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArsip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="2"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/kelola_aksi_arsip"
                android:textAllCaps="false"
                android:textColor="@color/kibooz_red_danger"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Aksi kelas yang diarsipkan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPulihkan"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/kelola_aksi_pulihkan"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_primary_purple"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
