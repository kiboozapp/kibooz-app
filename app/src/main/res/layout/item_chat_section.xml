<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/baloo2"
        android:textColor="@color/kibooz_text_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardClassFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:contentDescription="@string/chat_filter_kelas_cd"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:cardBackgroundColor="@color/kibooz_lavender_light"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#DDD0F9"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvClassFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/baloo2"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:maxWidth="180dp"
            android:minHeight="36dp"
            android:paddingHorizontal="12dp"
            android:text="@string/chat_semua_kelas"
            android:textColor="@color/kibooz_primary_purple"
            android:textSize="12sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
