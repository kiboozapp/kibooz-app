<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootLeaderboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_leaderboard_screen">

    <!-- Top App Bar with Insets -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitleBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2"
            android:text="@string/leaderboard_judul"
            android:textColor="@color/kibooz_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pilihan rentang poin: semester (bawaan server), hari, minggu atau bulan -->
    <LinearLayout
        android:id="@+id/llPeriodContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_leaderboard_tabs_container"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <TextView
            android:id="@+id/tabSemester"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_leaderboard_tab_active"
            android:fontFamily="@font/baloo2"
            android:gravity="center"
            android:text="@string/leaderboard_tab_semester"
            android:textColor="@color/kibooz_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHariIni"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/baloo2"
            android:gravity="center"
            android:text="@string/leaderboard_tab_hari"
            android:textColor="#C7B4F5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMingguIni"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/baloo2"
            android:gravity="center"
            android:text="@string/leaderboard_tab_minggu"
            android:textColor="#C7B4F5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBulanIni"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/baloo2"
            android:gravity="center"
            android:text="@string/leaderboard_tab_bulan"
            android:textColor="#C7B4F5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Podium Section (Juara 1, 2, 3) -->
    <LinearLayout
        android:id="@+id/llPodiumSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/llPeriodContainer">

        <!-- Juara 2 (Melarini - Kiri) -->
        <LinearLayout
            android:id="@+id/podiumRank2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Avatar Juara 2 (Perfect Circle via MaterialCardView) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="62dp"
                android:layout_height="62dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="31dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@color/kibooz_white"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatarRank2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar_siswa" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Flame Points Badge (Solid High Contrast Opaque) -->
            <TextView
                android:id="@+id/tvPoinRank2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-11dp"
                android:background="@drawable/bg_pill_flame_badge"
                android:elevation="4dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="🔥 850 Poin"
                android:textColor="@color/kibooz_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvNameRank2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:text="…"
                android:textColor="@color/kibooz_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Balok Podium 2 (Taller, extending deep under white sheet) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_podium_2"
                android:elevation="4dp"
                android:gravity="top|center_horizontal"
                android:paddingTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="2"
                    android:textColor="@color/kibooz_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Juara 1 (Novita Sari - Tengah - Paling Tinggi) -->
        <LinearLayout
            android:id="@+id/podiumRank1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Golden Crown -->
            <ImageView
                android:id="@+id/ivCrown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Mahkota Juara 1"
                android:src="@drawable/ic_crown" />

            <!-- Avatar Juara 1 (Perfect Circle via MaterialCardView) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginTop="-4dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="37dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@color/kibooz_white"
                app:strokeWidth="3dp">

                <ImageView
                    android:id="@+id/ivAvatarRank1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar_siswa" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Flame Points Badge (Solid High Contrast Opaque) -->
            <TextView
                android:id="@+id/tvPoinRank1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:background="@drawable/bg_pill_flame_badge"
                android:elevation="4dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:paddingVertical="3dp"
                android:text="🔥 899 Poin"
                android:textColor="@color/kibooz_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvNameRank1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:text="…"
                android:textColor="@color/kibooz_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Balok Podium 1 (Taller, extending deep under white sheet) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_podium_1"
                android:elevation="6dp"
                android:gravity="top|center_horizontal"
                android:paddingTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="1"
                    android:textColor="@color/kibooz_white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Juara 3 (Amelia Zahra - Kanan) -->
        <LinearLayout
            android:id="@+id/podiumRank3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Avatar Juara 3 (Perfect Circle via MaterialCardView) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="62dp"
                android:layout_height="62dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="31dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@color/kibooz_white"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatarRank3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar_siswa" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Flame Points Badge (Solid High Contrast Opaque) -->
            <TextView
                android:id="@+id/tvPoinRank3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-11dp"
                android:background="@drawable/bg_pill_flame_badge"
                android:elevation="4dp"
                android:fontFamily="@font/baloo2"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="🔥 829 Poin"
                android:textColor="@color/kibooz_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvNameRank3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo2"
                android:text="…"
                android:textColor="@color/kibooz_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Balok Podium 3 (Taller, extending deep under white sheet) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_podium_3"
                android:elevation="3dp"
                android:gravity="top|center_horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text="3"
                    android:textColor="@color/kibooz_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- White Bottom Sheet Container with Rounded Top Corners -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomSheetLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-42dp"
        app:cardBackgroundColor="#FAF9FD"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TopRounded36"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llPodiumSection">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Drag Handle -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_dot_inactive" />

                <TextView
                    android:id="@+id/tvRankingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/baloo2"
                    android:text="@string/leaderboard_semua_judul"
                    android:textColor="@color/kibooz_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llRankings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/leaderboard_kosong"
                    android:textColor="@color/kibooz_text_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
