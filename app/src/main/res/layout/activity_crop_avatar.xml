<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161224">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1930"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/batal"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/avatar_crop_judul"
            android:textColor="@color/kibooz_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.nthb.kibooz.ui.account.CropOverlayView
        android:id="@+id/cropOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomActions"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/baloo2"
        android:gravity="center"
        android:text="@string/avatar_crop_petunjuk"
        android:textColor="#D8D2EE"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar" />

    <LinearLayout
        android:id="@+id/clBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1930"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPutar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/baloo2"
            android:text="@string/avatar_crop_putar"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_white"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            app:strokeColor="#6E6396" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpanFoto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.3"
            android:fontFamily="@font/baloo2"
            android:text="@string/avatar_crop_simpan"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kibooz_primary_purple"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
