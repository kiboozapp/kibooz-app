<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Top App Bar / Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved_purple"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="@+id/tvHeaderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHeaderTitle"
            app:tint="@color/kibooz_white" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/baloo2"
            android:text="Ruang Kelas"
            android:textColor="@color/kibooz_white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Gabung Kelas Pill Button (Screenshot 154028) -->
        <LinearLayout
            android:id="@+id/btnGabungKelas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gabung_kelas"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvHeaderTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHeaderTitle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="@string/pindah_kelas_tombol"
                android:textColor="@color/kibooz_primary_purple"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Pindah Kelas"
                android:src="@drawable/ic_join_class"
                app:tint="@color/kibooz_primary_purple" />

        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitleRuangKelas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/baloo2"
            android:text="Aktivitas kelas belajar, eksplorasi emosi &amp; materi si kecil"
            android:textColor="#E0DBF5"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/clBottomNavigation"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Banner Pengajuan Pindah Kelas Pending -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusPindah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFBEB"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#F59E0B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvStatusPindah"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/baloo2"
                        android:textColor="#92400E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatalPindah"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:fontFamily="@font/baloo2"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/pindah_kelas_batalkan"
                        android:textAllCaps="false"
                        android:textColor="@color/kibooz_red_danger"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar (Screenshot 154028) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Cari"
                    android:src="@drawable/ic_search"
                    app:tint="@color/kibooz_text_muted" />

                <EditText
                    android:id="@+id/etSearchKelas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:fontFamily="@font/baloo2"
                    android:hint="Cari Tema Pembelajaran / Modul"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColor="@color/kibooz_text_dark"
                    android:textColorHint="@color/kibooz_text_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 2-Column Grid of 6 Subject Cards (Screenshot 154028) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- 1. Seni & Kreativitas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelSeni"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#F47B20"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_seni" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Seni &amp;\nKreativitas"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Bahasa & Komunikasi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelBahasa"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#F3A738"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_bahasa" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Bahasa &amp;\nKomunikasi"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Berpikir & Logika -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelLogika"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#4CB5AB"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_logika" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Berpikir &amp;\nLogika"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Belajar Fisik Motorik -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelMotorik"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#4EBA53"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_motorik" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Belajar Fisik\nMotorik"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Nilai Agama & Moral -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelAgama"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#EE5D6C"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_agama" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Nilai Agama\n&amp; Moral"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Sosial & Emotional -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapelSosial"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#C72A35"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_mapel_sosial" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/baloo2"
                            android:gravity="center"
                            android:text="Sosial &amp;\nEmotional"
                            android:textColor="@color/kibooz_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (Wali: Home, Sampah, Scan Sampah FAB, Ranking, Profil) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_card_white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 2: Statistik Sampah -->
            <LinearLayout
                android:id="@+id/tabSampah"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Center Placeholder for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Tab 4: Leaderboard / Ranking -->
            <LinearLayout
                android:id="@+id/tabLeaderboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 5: Profil Siswa -->
            <LinearLayout
                android:id="@+id/tabProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Floating Action Button (Scan Waste / Sampah) -->
    <ImageButton
        android:id="@+id/fabScannerSampah"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab_scanner"
        android:contentDescription="Scan Sampah AI"
        android:elevation="16dp"
        android:src="@drawable/ic_scan_waste"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
