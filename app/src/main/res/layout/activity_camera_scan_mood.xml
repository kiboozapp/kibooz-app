<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Overlay Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#80000000"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/baloo2"
            android:text="AI Pemindai Mood Siswa"
            android:textColor="@color/kibooz_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivFlash"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Flashlight"
            android:src="@drawable/ic_refresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Viewport: live preview, face overlay and hints -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCameraViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomControls"
        app:layout_constraintTop_toBottomOf="@+id/clTopOverlay">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <com.nthb.kibooz.ui.common.FaceOverlayView
            android:id="@+id/faceOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Low Light Warning -->
        <TextView
            android:id="@+id/tvLowLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#CCE53935"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mood_cahaya_rendah"
            android:textColor="@color/kibooz_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Penanda model pengganti, tampil selama modelnya masih contoh -->
        <TextView
            android:id="@+id/tvModelContoh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:background="#CCF57C00"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/model_contoh_banner"
            android:textColor="@color/kibooz_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center AI Guidance Notice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#99000000"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Arahkan ke kelompok siswa untuk deteksi multi-wajah otomatis"
            android:textColor="@color/kibooz_white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Permission Denied Panel -->
    <include
        android:id="@+id/layoutIzinKamera"
        layout="@layout/view_camera_permission_denied"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTopOverlay" />

    <!-- Bottom Action Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDetectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2"
            android:text="2 Wajah Siswa Terdeteksi &amp; Teridentifikasi"
            android:textColor="@color/kibooz_text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Capture / Shutter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCaptureMood"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Tinjau Hasil Scan (2 Siswa)"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kibooz_primary_purple"
            app:cornerRadius="25dp"
            app:layout_constraintTop_toBottomOf="@+id/tvDetectionStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
