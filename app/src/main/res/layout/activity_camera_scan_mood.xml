<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Overlay Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#80000000"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/baloo2"
            android:text="AI Pemindai Mood Siswa"
            android:textColor="@color/kibooz_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivFlash"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Flashlight"
            android:src="@drawable/ic_refresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/kibooz_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Viewport / Detection Area Simulated -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCameraViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottomControls"
        app:layout_constraintTop_toBottomOf="@+id/clTopOverlay">

        <!-- Visual scanning line / grid subtle overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#205D40B3" />

        <!-- Detected Face 1: Amelia (Happy) -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="170dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.3">

            <!-- Detection Bounding Box Border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_button_google" />

            <!-- AI Emotion Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFC107"
                android:fontFamily="@font/baloo2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="😊 Happy (94%)"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="Amelia Siti Zahra"
                android:textColor="@color/kibooz_white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Detected Face 2: Kenzo (Kalem) -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="170dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.85"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.25">

            <!-- Detection Bounding Box Border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_button_google" />

            <!-- AI Emotion Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#4CAF50"
                android:fontFamily="@font/baloo2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="😌 Kalem (89%)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2"
                android:text="Kenzo Putra"
                android:textColor="@color/kibooz_white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Center AI Guidance Notice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#99000000"
            android:fontFamily="@font/baloo2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Arahkan ke kelompok siswa untuk deteksi multi-wajah otomatis"
            android:textColor="@color/kibooz_white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Action Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDetectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2"
            android:text="2 Wajah Siswa Terdeteksi &amp; Teridentifikasi"
            android:textColor="@color/kibooz_text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Capture / Shutter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCaptureMood"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/baloo2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Simpan Hasil Mood Siswa"
            android:textAllCaps="false"
            android:textColor="@color/kibooz_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kibooz_primary_purple"
            app:cornerRadius="25dp"
            app:layout_constraintTop_toBottomOf="@+id/tvDetectionStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
