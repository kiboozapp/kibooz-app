<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kibooz_background">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/clBottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Curved Purple Background -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTopHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_curved_purple"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="48dp">

                <!-- Logo & App Title -->
                <ImageView
                    android:id="@+id/ivHeaderLogo"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_kibooz_bear"
                    android:contentDescription="Logo Kibooz"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/baloo2"
                    android:text="Kibooz Guru"
                    android:textColor="@color/kibooz_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/ivHeaderLogo"
                    app:layout_constraintStart_toEndOf="@+id/ivHeaderLogo"
                    app:layout_constraintTop_toTopOf="@+id/ivHeaderLogo" />

                <!-- Action Icons (History & Notification) -->
                <ImageView
                    android:id="@+id/ivHistory"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Riwayat"
                    app:layout_constraintBottom_toBottomOf="@+id/tvHeaderTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvHeaderTitle" />

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifikasi"
                    app:layout_constraintBottom_toBottomOf="@+id/ivHistory"
                    app:layout_constraintEnd_toStartOf="@+id/ivHistory"
                    app:layout_constraintTop_toTopOf="@+id/ivHistory" />

                <!-- Greeting Profile Row -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivHeaderLogo">

                    <ImageView
                        android:id="@+id/ivAvatarGuru"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar_guru"
                        android:contentDescription="Foto Ibu Siti Rahayu" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/cvAvatar"
                    app:layout_constraintEnd_toStartOf="@+id/tvDate"
                    app:layout_constraintStart_toEndOf="@+id/cvAvatar"
                    app:layout_constraintTop_toTopOf="@+id/cvAvatar">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo2"
                        android:id="@+id/tvGreeting"
                        android:text="Selamat datang"
                        android:textColor="#E5DEFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo2"
                        android:id="@+id/tvTeacherName"
                        android:text="…"
                        android:textColor="@color/kibooz_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2"
                    android:text=""
                    android:textColor="#E5DEFF"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/cvAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cvAvatar" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stats Capsule Row Card (Overlapping header) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-28dp"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <!-- Stat 1: Jumlah Siswa -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="Jumlah Siswa"
                            android:textColor="@color/kibooz_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/baloo2"
                            android:id="@+id/tvTotalSiswa"
                            android:text="…"
                            android:textColor="@color/kibooz_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/kibooz_border" />

                    <!-- Stat 2: Rata-rata Happy -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="Mood dominan"
                            android:textColor="@color/kibooz_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/baloo2"
                            android:id="@+id/tvMoodDominan"
                            android:text="…"
                            android:textColor="@color/kibooz_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/kibooz_border" />

                    <!-- Stat 3: Sampah terScan -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHadirLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2"
                            android:text="Hadir hari ini"
                            android:textColor="@color/kibooz_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/baloo2"
                            android:id="@+id/tvHadir"
                            android:text="…"
                            android:textColor="@color/kibooz_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Pemilih kelas aktif untuk multi-kelas Guru -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClassSwitcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E8E4F8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_class"
                        app:tint="@color/kibooz_primary_purple" />

                    <TextView
                        android:id="@+id/tvSelectedClass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/baloo2"
                        android:maxLines="1"
                        android:textColor="@color/kibooz_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSwitchClassBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_lavender"
                        android:fontFamily="@font/baloo2"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/guru_ganti_kelas_pill"
                        android:textColor="@color/kibooz_primary_purple"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Gangguan server: offline atau layanan tidak tersedia (FE-12) -->
            <com.nthb.kibooz.ui.common.ConnectionStatusView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Card: Mood Kelas Hari Ini -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvMoodKelas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/kibooz_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/baloo2"
                            android:text="Mood Kelas Hari Ini"
                            android:textColor="@color/kibooz_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/btnScanUlang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_tag_lavender"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_refresh" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/baloo2"
                                android:text="Scan Ulang"
                                android:textColor="@color/kibooz_primary_purple"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </RelativeLayout>

                    <!-- Donut Chart & Legend Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Custom Donut Chart -->
                        <com.nthb.kibooz.ui.common.DonutMoodChartView
                            android:id="@+id/donutMoodChart"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_marginStart="8dp" />

                        <!-- Legend Items -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:orientation="vertical">

                            <!-- Happy -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="@drawable/bg_dot_active"
                                    android:backgroundTint="@color/mood_happy" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/baloo2"
                                    android:id="@+id/tvLegendSenang"
                                    android:text="Senang"
                                    android:textColor="@color/kibooz_text_primary"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- Bingung -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="@drawable/bg_dot_active"
                                    android:backgroundTint="@color/mood_bingung" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/baloo2"
                                    android:id="@+id/tvLegendBingung"
                                    android:text="Bingung"
                                    android:textColor="@color/kibooz_text_primary"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- Kalem -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="@drawable/bg_dot_active"
                                    android:backgroundTint="@color/mood_sedih" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/baloo2"
                                    android:id="@+id/tvLegendSedih"
                                    android:text="Sedih"
                                    android:textColor="@color/kibooz_text_primary"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- Marah -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="@drawable/bg_dot_active"
                                    android:backgroundTint="@color/mood_marah" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/baloo2"
                                    android:id="@+id/tvLegendMarah"
                                    android:text="Marah"
                                    android:textColor="@color/kibooz_text_primary"
                                    android:textSize="13sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Subtext -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/baloo2"
                        android:id="@+id/tvKelasInfo"
                        android:text=""
                        android:textColor="@color/kibooz_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Banner: Ranking Poin Kelas -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvRankingKelas"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_banner_ranking"
                    android:contentDescription="Banner Ranking Poin Kelas" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar with Curved Cutout / Notched Center FAB -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/kibooz_white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Tab 1: Home (Active) -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/kibooz_primary_purple" />

            </LinearLayout>

            <!-- Tab 2: Statistik -->
            <LinearLayout
                android:id="@+id/tabStatistik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Center Placeholder for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Tab 4: Kelas -->
            <LinearLayout
                android:id="@+id/tabKelas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_class"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

            <!-- Tab 5: Profil -->
            <LinearLayout
                android:id="@+id/tabProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/kibooz_text_muted" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Floating Action Button (Scan Face / Mood) -->
    <ImageButton
        android:id="@+id/fabScanner"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab_scanner"
        android:contentDescription="Scan Mood Siswa"
        android:elevation="16dp"
        android:src="@drawable/ic_scan_face"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
