{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "assignees": ["SyafaHadyan"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "gradle-minor-patch"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions"
    },
    {
      "description": "the tools that a workflow starts by version take the commit type of the workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci"
    },
    {
      "description": "a major release of the Android Gradle plugin, Kotlin or Gradle has to move with the others, so it waits for a tick in the dependency dashboard",
      "matchDepNames": ["com.android.application", "org.jetbrains.kotlin.android", "gradle"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "A version in a workflow that the line above names with a renovate comment, which the bot cannot find in a run step otherwise",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z][A-Z0-9_]*_VERSION: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
